# Copie ce fichier en .env et remplace les valeurs.
# Génère chaque secret avec :
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# --- obligatoire -------------------------------------------------------------

# Clé partagée par tous les agents. C'est elle que tu passes à install.ps1.
API_KEY=change-moi

# Mot de passe d'accès au tableau de bord.
# En changer déconnecte immédiatement toutes les sessions ouvertes.
DASH_PASS=change-moi-aussi

# --- réseau ------------------------------------------------------------------

PORT=8080
# Derrière un reverse proxy sur la même machine, préfère 127.0.0.1 :
# le serveur devient alors injoignable directement depuis l'extérieur.
HOST=127.0.0.1

# --- stockage ----------------------------------------------------------------

DB_PATH=./data/komoku.db

# Durée de conservation des mesures détaillées, en jours.
# 30 jours × 100 postes × une mesure toutes les 3 min ≈ 1,4 million de lignes,
# soit une base de quelques dizaines de Mo. SQLite encaisse sans broncher.
RETENTION_DAYS=30

# --- comportement ------------------------------------------------------------

# Un poste sans signe de vie au-delà de ce délai est marqué hors ligne.
# Garde au moins trois fois l'intervalle des agents, pour qu'un envoi raté
# isolé ne déclenche pas une fausse alerte.
OFFLINE_AFTER_MINUTES=12

# Durée de validité d'une session du tableau de bord, en jours.
SESSION_DAYS=14

# Signaler les postes sans VPN actif. À n'activer que si le VPN est
# effectivement obligatoire chez toi, sinon le tableau vire à l'orange pour rien.
VPN_REQUIRED=false
